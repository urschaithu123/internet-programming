
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Library Management System</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f5f3ff;
    color: #252347;
}

/* Header */
header {
    background: linear-gradient(135deg, #312e81, #6d28d9);
    color: white;
    padding: 25px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

header h1 {
    font-size: 27px;
}

header p {
    margin-top: 6px;
    color: #ddd6fe;
}

/* Navigation */
nav {
    background: white;
    padding: 18px 8%;
    display: flex;
    justify-content: center;
    gap: 35px;
    flex-wrap: wrap;
    box-shadow: 0 3px 12px #0000000d;
}

nav a {
    color: #37306d;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

nav a:hover {
    color: #9333ea;
}

/* Hero Section */
.hero {
    margin: 30px auto;
    width: 84%;
    min-height: 280px;
    border-radius: 20px;
    background: linear-gradient(120deg, #ede9fe, #ddd6fe);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 45px;
    gap: 25px;
}

.hero-content {
    max-width: 600px;
}

.hero h2 {
    font-size: 38px;
    color: #312e81;
    margin-bottom: 18px;
}

.hero p {
    font-size: 17px;
    line-height: 1.8;
    color: #514b75;
}

.hero-icon {
    font-size: 100px;
}

/* Buttons */
button {
    background: #6d28d9;
    color: white;
    padding: 12px 22px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
    margin-top: 18px;
    transition: 0.3s;
}

button:hover {
    background: #4c1d95;
    transform: translateY(-2px);
}

/* Section */
.section-title {
    text-align: center;
    margin: 45px 0 10px;
    font-size: 30px;
    color: #312e81;
}

.section-subtitle {
    text-align: center;
    color: #77718e;
    margin-bottom: 30px;
}

/* Cards */
.container {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
    width: 90%;
    margin: 30px auto 50px;
}

.card {
    background: white;
    width: 260px;
    padding: 28px 22px;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 5px 20px #312e8110;
    border: 1px solid #e9e5ff;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-7px);
    box-shadow: 0 10px 25px #6d28d922;
}

.card-icon {
    font-size: 45px;
    margin-bottom: 15px;
}

.card h3 {
    color: #4338a5;
    margin-bottom: 12px;
}

.card p {
    color: #77718e;
    line-height: 1.6;
}

/* Login Form */
#loginBox {
    display: none;
    background: white;
    width: 380px;
    max-width: 90%;
    padding: 30px;
    margin: 35px auto;
    border-radius: 18px;
    box-shadow: 0 8px 30px #312e8120;
    border-top: 5px solid #7c3aed;
}

#loginBox h2 {
    text-align: center;
    color: #312e81;
    margin-bottom: 22px;
}

#loginBox label {
    display: block;
    margin-top: 14px;
    font-weight: bold;
    color: #514b75;
}

#loginBox input {
    width: 100%;
    padding: 12px;
    margin-top: 7px;
    border: 1px solid #d6d0eb;
    border-radius: 8px;
    outline: none;
}

#loginBox input:focus {
    border-color: #7c3aed;
    box-shadow: 0 0 5px #7c3aed44;
}

#loginBox button {
    width: 100%;
}

#loginBox .close-btn {
    background: #e9e5f5;
    color: #37306d;
    margin-top: 10px;
}

#loginBox .close-btn:hover {
    background: #d8d0ef;
}

#message {
    margin-top: 15px;
    text-align: center;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

/* Contact */
.contact {
    background: #ede9fe;
    text-align: center;
    padding: 35px 20px;
    margin-top: 50px;
}

.contact h2 {
    color: #312e81;
    margin-bottom: 12px;
}

.contact p {
    color: #625b83;
    line-height: 1.7;
}

/* Footer */
footer {
    background: #211c4d;
    color: white;
    text-align: center;
    padding: 20px;
}

/* Mobile Layout */
@media (max-width: 650px) {
    header {
        text-align: center;
        justify-content: center;
    }

    nav {
        gap: 18px;
        padding: 18px 10px;
    }

    .hero {
        width: 92%;
        padding: 30px 22px;
        text-align: center;
        flex-direction: column;
    }

    .hero h2 {
        font-size: 29px;
    }

    .hero-icon {
        font-size: 65px;
    }

    .card {
        width: 100%;
        max-width: 350px;
    }
}
</style>
</head>

<body>

<header>
    <div>
        <h1>📚 Library Management</h1>
        <p>Your Gateway to Knowledge</p>
    </div>
    <div>Learn · Read · Grow</div>
</header>

<nav>
    <a href="#home">Home</a>
    <a href="#books">Services</a>
    <a href="#loginBox" onclick="showLogin('Student')">Student Login</a>
    <a href="#loginBox" onclick="showLogin('Student')">Register</a>
    <a href="#contact">Contact</a>
</nav>

<section class="hero" id="home">
    <div class="hero-content">
        <h2>Discover a World of Knowledge</h2>
        <p>
            Welcome to our Library Management System.
            Explore books, manage your borrowed books,
            and access learning resources in one place.
        </p>
        <button onclick="showBooks()">Explore Library</button>
    </div>

    <div class="hero-icon">📖</div>
</section>

<h2 class="section-title" id="books">Library Services</h2>
<p class="section-subtitle">Everything you need for your learning journey</p>

<div class="container">

    <div class="card">
        <div class="card-icon">🔎</div>
        <h3>Search Books</h3>
        <p>Find books by title, author, or category.</p>
        <button onclick="showBooks()">Search Books</button>
    </div>

    <div class="card">
        <div class="card-icon">🎓</div>
        <h3>Student Portal</h3>
        <p>Access your account and view borrowed books.</p>
        <button onclick="showLogin('Student')">Student Login</button>
    </div>

    <div class="card">
        <div class="card-icon">🛡️</div>
        <h3>Admin Portal</h3>
        <p>Manage books, student records, and fines.</p>
        <button onclick="showLogin('Admin')">Admin Login</button>
    </div>

</div>

<div id="loginBox">
    <h2 id="loginTitle">Student Login</h2>

    <form onsubmit="login(event)">
        <label for="username">Username or Email</label>
        <input type="text" id="username"
               placeholder="Enter your username" required>

        <label for="password">Password</label>
        <input type="password" id="password"
               placeholder="Enter your password" required>

        <button type="submit">Login</button>
        <button type="button" class="close-btn"
                onclick="closeLogin()">Close</button>
    </form>

    <p id="message"></p>
</div>

<section class="contact" id="contact">
    <h2>Contact Us</h2>
    <p>Need help? Contact your library administrator.</p>
    <p>📚 Your knowledge journey starts here!</p>
</section>

<footer>
    <p>© 2026 Library Management System | All Rights Reserved</p>
</footer>

<script>
let selectedRole = "Student";

function showLogin(role) {
    selectedRole = role;

    document.getElementById("loginTitle").textContent =
        role + " Login";

    document.getElementById("loginBox").style.display = "block";
    document.getElementById("message").textContent = "";

    document.getElementById("loginBox").scrollIntoView({
        behavior: "smooth",
        block: "center"
    });
}

function closeLogin() {
    document.getElementById("loginBox").style.display = "none";
}

function login(event) {
    event.preventDefault();

    let username = document.getElementById("username").value;

    document.getElementById("message").textContent =
        selectedRole + " login form submitted for " + username +
        ". Connect a backend to verify credentials.";
}

function showBooks() {
    alert("The book search feature is not connected yet.");
}
</script>

</body>
</html>
